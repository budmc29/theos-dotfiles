# Copy this file to ~/.secrets and fill in the values.
# ~/.secrets is gitignored and sourced by ~/.zshrc on shell startup.
# Never commit actual secret values.

# NPM/GitHub Packages token (classic PAT with read:packages scope)
# Generate at https://github.com/settings/tokens
NODE_AUTH_TOKEN=

# AWS account ID (used by aws_login alias in ~/.aliases)
AWS_ACCOUNT_ID=117771453557
